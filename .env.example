# ===== 复制此文件为 .env.local 并填入你的密钥 =====

# ===== Supabase 配置 =====
# 1. 登录 https://supabase.com
# 2. 进入你的项目 → Settings(齿轮) → API
# 3. 复制 Project URL 和 API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===== AI 模型配置 =====
# 方案1（推荐，国内可用）：DeepSeek
# - 注册：https://platform.deepseek.com（手机号+支付宝）
# - 价格：约¥1/百万token，Claude的十分之一
# - 兼容Anthropic API，无需修改代码
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_API_KEY=your-deepseek-api-key
AI_MODEL_NAME=deepseek-chat

# 方案2（需代理）：Anthropic Claude 官方
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_API_KEY=your-anthropic-api-key
# AI_MODEL_NAME=claude-3-5-sonnet-20241022

# ===== 应用配置 =====
NEXT_PUBLIC_APP_URL=http://localhost:3000
